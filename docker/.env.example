# Copy to .env (git-ignored) and fill in the three required values.
# An empty value means the default; defaults live in content/grange/config.py.
# GRANGE_GOSSIP_PORT, GRANGE_GROUP, and TS_TAG must be equal on every grange in a mesh.

# --- required -----------------------------------------------------------------
# This grange's id: 1-56 lowercase letters, digits, hyphens; no leading/trailing hyphen.
GRANGE_ID=
# Reusable tagged pre-auth key from the headscale admin (team password manager). Secret.
TS_AUTHKEY=
# Login server for the Tailscale sidecar, e.g. https://headscale.example.net
HEADSCALE_URL=

# --- ports and mesh -----------------------------------------------------------
# Localhost port farm and frolic use: http://127.0.0.1:7788
GRANGE_PORT=
# Tailnet port for /v1/gossip (default 7789); the headscale ACL names it.
GRANGE_GOSSIP_PORT=
# Mesh name carried in every record (default "default"); use a private one for protocol work.
GRANGE_GROUP=
# Tailnet tag that marks peers (default tag:grange).
TS_TAG=
# Testing only: static host:port list of the other granges; disables tag discovery.
GRANGE_PEERS=

# --- timing (seconds) ---------------------------------------------------------
# Own counter increase interval (default 10); keep well under every peer's EXPIRE_SECONDS.
HEARTBEAT_SECONDS=
# Farm silence before farm_stale (default 60).
FARM_STALE_SECONDS=
# Peer silence before removal from the board (default 60).
EXPIRE_SECONDS=
# How long a removed peer's version is remembered (default 600).
FORGET_SECONDS=
# Periodic repair exchange interval (default 3).
REPAIR_SECONDS=
# Peer list refresh interval (default 30).
DISCOVERY_SECONDS=
# Neighbours, including the ring successor (default 5).
FANOUT=
# Per-peer connect timeout (default 1).
CONNECT_TIMEOUT_SECONDS=
# Per-exchange total timeout (default 3).
EXCHANGE_TIMEOUT_SECONDS=

# --- freshness check ----------------------------------------------------------
# Kill-switch tag the image compares itself to (default agent-grange-latest).
CHECK_TAG=
# 1 = refuse to start if the tag cannot be verified (default); 0 = warn and start.
FRESHNESS_STRICT=
# How often the running grange re-checks the tag (default 30).
RECHECK_SECONDS=
# 1 = skip the freshness check entirely.
SKIP_FRESHNESS_CHECK=
# Token for a private repo; the Makefile borrows `gh auth token` when unset.
GITHUB_TOKEN=
